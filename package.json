{
  "name": "vanilla-js-timepicker",
  "version": "0.1.0",
  "description": "Lightweight vanilla JavaScript timepicker with no dependencies",
  "author": "tito10047",
  "license": "MIT",
  "keywords": [
    "timepicker",
    "time",
    "picker",
    "vanilla",
    "javascript",
    "typescript"
  ],
  "main": "dist/timepicker.cjs.js",
  "module": "dist/timepicker.esm.js",
  "browser": "dist/timepicker.umd.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/timepicker.esm.js",
      "require": "./dist/timepicker.cjs.js",
      "types": "./dist/types/index.d.ts"
    },
    "./dist/timepicker.css": "./dist/timepicker.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin typescript && npm run build:types",
    "build:watch": "rollup -c rollup.config.ts --configPlugin typescript --watch",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "dev": "vite"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "postcss": "^8.0.0",
    "rimraf": "^5.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-postcss": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "type": "module"
}